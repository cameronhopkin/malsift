# MalSift hardened static-analysis container.
#
# Runs ONLY the byte-parsing half of the pipeline (`malsift extract`): file type, hashes,
# entropy, strings, PE, YARA, IOC extraction, evasion detection, script preprocessing.
# The content guard and the LLM call run on the host over the JSON this prints.
#
# Build:  docker build -f Dockerfile.analyzer -t malsift-analyzer:latest .
# Run:    malsift analyze ./samples/x.bin --isolate docker      (recommended)
#    or:  SAMPLE=x.bin docker compose run --rm analyzer
#
# Runtime hardening (no network, read-only rootfs, cap-drop ALL, no-new-privileges,
# seccomp allowlist, resource limits) is applied by `malsift --isolate docker` and by
# docker-compose.yml; see README "Isolation".

ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE} AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /src
COPY pyproject.toml README.md LICENSE NOTICE ./
COPY malsift ./malsift
RUN python -m pip wheel --wheel-dir /wheels .

FROM ${PYTHON_IMAGE}
# libmagic for python-magic. Nothing else: no compilers, no shells beyond the base, no
# network tools. Optional analyzers (capa, radare2) can be layered on in a derived image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libmagic1 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /wheels /wheels
RUN python -m pip install --no-cache-dir --no-compile /wheels/*.whl \
 && rm -rf /wheels /root/.cache \
 && groupadd --system --gid 10001 malsift \
 && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin malsift
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp
USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["malsift"]
CMD ["--help"]
